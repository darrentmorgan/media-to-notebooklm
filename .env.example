# NotebookLM plan tier: free | plus | pro | ultra
NBLM_PLAN=free

# Optional: absolute path to the notebooklm executable. Auto-resolved if unset.
# NBLM_BIN=

# Optional (recommended in the cloud): YouTube Data API v3 key. Metadata falls
# back to yt-dlp when unset or when the API fails.
# YOUTUBE_API_KEY=

# Cloud sessions only: Playwright storage state from `notebooklm login`, as one
# line of JSON. Set this on the Claude Code environment, never in this file.
# NOTEBOOKLM_AUTH_JSON=

# Optional Telegram bridge (workstation only; see README "Optional: Telegram bridge").
# TELEGRAM_BOT_TOKEN=your_token_here
# TELEGRAM_ALLOWED_IDS=123456789
